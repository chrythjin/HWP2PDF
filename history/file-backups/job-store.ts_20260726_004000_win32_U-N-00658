import crypto from "node:crypto";
import { FieldPath, Firestore } from "@google-cloud/firestore";
import {
  TOMBSTONE_RETENTION_MS,
  UploadStatus,
  type PublicConversionErrorCode,
  type UploadSession,
} from "@hwp2pdf/shared";
import { config } from "../config.js";

// ---------------------------------------------------------------------------
// JobRecord — owner-aware, retention/tombstone-aware
// ---------------------------------------------------------------------------

export interface JobRecord {
  jobId: string;
  originalFileName: string;
  originalFileSize?: number;
  sourcePath: string;
  originalObjectPath?: string;
  resultPath?: string;
  resultObjectPath?: string;
  status: UploadStatus;
  progress: number;
  message?: string;
  errorCode?: PublicConversionErrorCode;
  downloadUrl?: string;
  expiresAt: string;
  createdAt: string;
  updatedAt: string;

  // --- Owner fields (decision D6/D7/D12) ---
  /** Discriminator: "user" for member jobs, "anonymous" for token-protected jobs. */
  ownerType?: "user" | "anonymous";
  /** Present when ownerType === "user". */
  userId?: string;
  /** SHA-256 hash of the anonymous access token. Present when ownerType === "anonymous". */
  accessTokenHash?: string;

  // --- Retention / TTL fields ---
  /** When the downloadable result file expires. Separate from metadataExpiresAt. */
  downloadExpiresAt?: string;
  /** When the job metadata/history entry expires (member 30-day retention). */
  metadataExpiresAt?: string;

  // --- Tombstone fields (decision D12) ---
  /** ISO timestamp when the member deleted the job. */
  deletedAt?: string;
  /** Who deleted the job (userId or "system"). */
  deletedBy?: string;
  /** Tombstone retention deadline; after this the metadata row may be purged. */
  tombstoneUntil?: string;
  /** Internal marker retained until physical storage cleanup succeeds. */
  cleanupPending?: boolean;
}

export type CreateJobInput = Omit<JobRecord, "createdAt" | "updatedAt">;
export type UpdateJobPatch = Partial<
  Omit<JobRecord, "jobId" | "createdAt" | "ownerType" | "userId" | "accessTokenHash" | "metadataExpiresAt">
>;
export type ClaimQueuedJobResult =
  | { status: "claimed"; job: JobRecord }
  | { status: "not_found" }
  | { status: "deleted"; current: JobRecord }
  | { status: "expired"; current: JobRecord }
  | { status: "already_processing"; current: JobRecord }
  | { status: "terminal"; current: JobRecord }
  | { status: "lock_lost"; current: JobRecord };
type ClaimMutationHook = () => void | Promise<void>;
export const JOB_PROCESSING_PROGRESS = 70;
export const JOB_PROCESSING_MESSAGE = "변환 작업을 처리하고 있습니다.";

// ---------------------------------------------------------------------------
// UploadSession record (server-side, stored in a sibling collection/map)
// ---------------------------------------------------------------------------

export type UploadSessionRecord = UploadSession & {
  status?: "active" | "completed" | "expired";
  expiredAt?: string;
  cleanupClaimedAt?: string;
  cleanupClaimId?: string;
  cleanupLeaseExpiresAt?: string;
  completionClaimId?: string;
  completionLeaseExpiresAt?: string;
};

export const PERSISTENT_CLAIM_LEASE_MS = 5 * 60_000;

export type UploadSessionCompletionClaimResult =
  | { status: "claimed"; session: UploadSessionRecord; existingJob?: JobRecord }
  | { status: "not_found" }
  | { status: "completed"; session: UploadSessionRecord }
  | { status: "expired"; session: UploadSessionRecord }
  | { status: "conflict"; session: UploadSessionRecord }
  | { status: "already_claimed"; session: UploadSessionRecord };

export type JobDeletionClaimResult =
  | { status: "claimed"; job: JobRecord; tombstone: JobRecord; claimId: string }
  | { status: "not_found" }
  | { status: "forbidden" }
  | { status: "processing"; job: JobRecord }
  | { status: "in_progress"; tombstone: JobRecord }
  | { status: "already_deleted"; tombstone: JobRecord };

export interface JobDeletionCleanupRecord {
  jobId: string;
  claimId: string;
  leaseExpiresAt: string;
  job: JobRecord;
}

export interface MaintenancePageOptions {
  cutoff: Date;
  limit: number;
  cursor?: string;
}

export interface RecoveredJobsPage {
  jobs: JobRecord[];
  nextCursor?: string;
}

export interface PurgedJobsPage {
  purged: number;
  hasMore: boolean;
}

export interface JobDeletionCleanupPage {
  claims: Array<{ job: JobRecord; claimId: string }>;
  hasMore: boolean;
}

export interface ExpiredUploadSessionsPage {
  sessions: UploadSessionRecord[];
  nextCursor?: string;
  cleanupDiagnostics: CleanupDiagnostics;
}

export interface CleanupDiagnostics {
  completedOrStatus: number;
  alreadyClaimed: number;
  invalidExpiry: number;
  expiryAfterCutoff: number;
  identityMismatch: number;
  accepted: number;
}

function emptyCleanupDiagnostics(): CleanupDiagnostics {
  return {
    completedOrStatus: 0,
    alreadyClaimed: 0,
    invalidExpiry: 0,
    expiryAfterCutoff: 0,
    identityMismatch: 0,
    accepted: 0,
  };
}

type CleanupDecision = Exclude<keyof CleanupDiagnostics, "accepted"> | { accepted: UploadSessionRecord };

function classifyUploadCleanupCandidate(
  current: UploadSessionRecord,
  scanned: UploadSessionRecord,
  cutoff: Date,
): CleanupDecision {
  if (current.completedAt || current.status === "completed") return "completedOrStatus";
  if (current.cleanupClaimId && Date.parse(current.cleanupLeaseExpiresAt ?? "") > cutoff.getTime()) {
    return "alreadyClaimed";
  }
  if (
    !current.cleanupClaimId
    && current.cleanupClaimedAt
    && Date.parse(current.cleanupClaimedAt) + PERSISTENT_CLAIM_LEASE_MS > cutoff.getTime()
  ) {
    return "alreadyClaimed";
  }
  if (current.completionClaimId && Date.parse(current.completionLeaseExpiresAt ?? "") > cutoff.getTime()) {
    return "alreadyClaimed";
  }
  const expiresAt = Date.parse(current.expiresAt);
  if (!Number.isFinite(expiresAt)) return "invalidExpiry";
  if (expiresAt > cutoff.getTime()) return "expiryAfterCutoff";
  if (!hasSameUploadCleanupIdentity(current, scanned)) return "identityMismatch";
  return { accepted: current };
}

type MaintenanceMutationHook = (jobId: string) => void | Promise<void>;

function maintenanceCursor(timestamp: string, id: string) {
  return Buffer.from(JSON.stringify([1, timestamp, id]), "utf8").toString("base64url");
}

function parseMaintenanceCursor(cursor: string | undefined): [string, string] | null {
  if (!cursor) return null;
  try {
    const decoded: unknown = JSON.parse(Buffer.from(cursor, "base64url").toString("utf8"));
    if (
      !Array.isArray(decoded)
      || decoded.length !== 3
      || decoded[0] !== 1
      || typeof decoded[1] !== "string"
      || typeof decoded[2] !== "string"
    ) {
      throw new Error("Invalid maintenance cursor");
    }
    return [decoded[1], decoded[2]];
  } catch {
    throw new Error("Invalid maintenance cursor");
  }
}

function isAfterMaintenanceCursor(timestamp: string, id: string, cursor: [string, string] | null) {
  return !cursor || timestamp > cursor[0] || (timestamp === cursor[0] && id > cursor[1]);
}

function hasSameUploadCleanupIdentity(current: UploadSessionRecord, candidate: UploadSessionRecord) {
  return current.jobId === candidate.jobId
    && current.objectPath === candidate.objectPath
    && current.ownerType === candidate.ownerType
    && current.userId === candidate.userId
    && current.accessTokenHash === candidate.accessTokenHash
    && current.expiresAt === candidate.expiresAt;
}

function isUploadCleanupEligible(session: UploadSessionRecord) {
  const legacyLeaseExpiresAt = session.cleanupClaimedAt
    ? Date.parse(session.cleanupClaimedAt) + PERSISTENT_CLAIM_LEASE_MS
    : Number.NEGATIVE_INFINITY;
  return session.status === "expired"
    && !session.completedAt
    && (
      session.cleanupClaimId
        ? Date.parse(session.cleanupLeaseExpiresAt ?? "") <= Date.now()
        : legacyLeaseExpiresAt <= Date.now()
    );
}

function leaseExpiresAt(now = new Date()) {
  return new Date(now.getTime() + PERSISTENT_CLAIM_LEASE_MS).toISOString();
}

function hasSameUploadJobIdentity(job: JobRecord, session: UploadSessionRecord) {
  return job.jobId === session.jobId
    && job.originalFileName === session.fileName
    && job.originalFileSize === session.fileSize
    && job.originalObjectPath === session.objectPath
    && job.ownerType === session.ownerType
    && job.userId === session.userId
    && job.accessTokenHash === session.accessTokenHash;
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/** True when the download deadline (downloadExpiresAt, falling back to expiresAt) has passed. */
export function isDownloadExpired(job: JobRecord): boolean {
  const deadline = job.downloadExpiresAt ?? job.expiresAt;
  return Date.parse(deadline) <= Date.now();
}

/** True when the metadata retention deadline has passed (member 30-day retention). */
export function isMetadataExpired(job: JobRecord): boolean {
  if (!job.metadataExpiresAt) return false;
  return Date.parse(job.metadataExpiresAt) <= Date.now();
}

/** Legacy compatibility: a job is "expired" when its download deadline passes. */
function isExpired(job: JobRecord) {
  return isDownloadExpired(job);
}

function toExpiredJob(job: JobRecord): JobRecord {
  return {
    ...job,
    status: "expired",
    progress: job.progress,
    downloadUrl: undefined,
    message: "다운로드 가능 시간이 만료되었습니다. 파일을 다시 업로드하세요.",
    updatedAt: new Date().toISOString(),
  };
}

/** True when the job is in the deleted/tombstone state. */
function isDeleted(job: JobRecord): boolean {
  return job.status === "deleted" || job.deletedAt !== undefined;
}

/** True when the tombstone retention period has elapsed (safe to purge). */
function isTombstonePurged(job: JobRecord): boolean {
  if (!job.tombstoneUntil) return false;
  return Date.parse(job.tombstoneUntil) <= Date.now();
}

function classifyUnclaimableJob(job: JobRecord): Exclude<ClaimQueuedJobResult, { status: "claimed" } | { status: "not_found" }> | null {
  if (isDeleted(job)) return { status: "deleted", current: job };
  if (job.status === "expired" || isExpired(job)) return { status: "expired", current: job };
  if (job.status === "processing") return { status: "already_processing", current: job };
  if (job.status === "completed" || job.status === "failed") return { status: "terminal", current: job };
  if (job.status !== "queued") return { status: "lock_lost", current: job };
  return null;
}

function toProcessingJob(job: JobRecord): JobRecord {
  return {
    ...job,
    status: "processing",
    progress: JOB_PROCESSING_PROGRESS,
    message: JOB_PROCESSING_MESSAGE,
    updatedAt: new Date().toISOString(),
  };
}

function toDeletedJob(current: JobRecord, deletedBy: string): JobRecord {
  const now = new Date();
  const nowIso = now.toISOString();
  return {
    jobId: current.jobId,
    originalFileName: "[deleted]",
    sourcePath: "[deleted]",
    status: "deleted",
    progress: 0,
    expiresAt: current.expiresAt,
    ownerType: current.ownerType,
    userId: current.userId,
    createdAt: current.createdAt,
    updatedAt: nowIso,
    deletedAt: nowIso,
    deletedBy,
    tombstoneUntil: new Date(now.getTime() + TOMBSTONE_RETENTION_MS).toISOString(),
    cleanupPending: true,
  };
}

function applyJobPatch(current: JobRecord, patch: UpdateJobPatch): JobRecord {
  const runtimePatch = patch as UpdateJobPatch & { metadataExpiresAt?: unknown };
  const { metadataExpiresAt: _ignoredMetadataExpiry, ...safePatch } = runtimePatch;
  return { ...current, ...safePatch, updatedAt: new Date().toISOString() };
}

function toFinalizedTombstone(current: JobRecord): JobRecord {
  const { cleanupPending: _cleanupPending, ...tombstone } = current;
  return {
    ...tombstone,
    updatedAt: new Date().toISOString(),
  };
}

function finalizedDeletionResult(current: JobRecord | undefined, cleanup: JobDeletionCleanupRecord): JobRecord {
  if (current) return toFinalizedTombstone(current);
  return toFinalizedTombstone(toDeletedJob(cleanup.job, cleanup.job.userId ?? "system"));
}

function classifyJobDeletion(current: JobRecord | undefined, deletedBy: string): Exclude<JobDeletionClaimResult, { status: "claimed" }> | null {
  if (!current) return { status: "not_found" };
  if (isDeleted(current)) {
    return current.cleanupPending
      ? { status: "in_progress", tombstone: current }
      : { status: "already_deleted", tombstone: current };
  }
  if (deletedBy !== "system" && (current.ownerType !== "user" || current.userId !== deletedBy)) {
    return { status: "forbidden" };
  }
  if (deletedBy !== "system" && isMetadataExpired(current)) return { status: "not_found" };
  if (current.status === "processing") return { status: "processing", job: current };
  return null;
}

// ---------------------------------------------------------------------------
// JobStore interface
// ---------------------------------------------------------------------------

export interface ListJobsByUserOptions {
  /** Include deleted/tombstoned jobs in the result. Default: false. */
  includeDeleted?: boolean;
  /** Maximum number of jobs to return. */
  limit?: number;
  /** Pagination offset. */
  offset?: number;
}

interface JobStore {
  // --- Original CRUD (preserved) ---
  createJob(input: CreateJobInput): Promise<JobRecord>;
  getJob(jobId: string): Promise<JobRecord | undefined>;
  updateJob(jobId: string, patch: UpdateJobPatch): Promise<JobRecord | undefined>;
  claimQueuedJobForProcessing(jobId: string, beforeCommit?: ClaimMutationHook): Promise<ClaimQueuedJobResult>;
  recoverStaleProcessingJobs(
    options: MaintenancePageOptions,
    beforeCommit?: MaintenanceMutationHook,
  ): Promise<RecoveredJobsPage>;

  // --- Owner-aware lookups ---
  getJobForUser(jobId: string, userId: string): Promise<JobRecord | null>;
  getJobForAnonymous(jobId: string, accessTokenHash: string): Promise<JobRecord | null>;
  listJobsByUser(userId: string, options?: ListJobsByUserOptions): Promise<JobRecord[]>;
  claimJobDeletion(jobId: string, deletedBy: string, claimId: string): Promise<JobDeletionClaimResult>;
  finalizeJobDeletion(jobId: string, claimId: string): Promise<JobRecord | null>;
  claimExpiredJobDeletions(options: MaintenancePageOptions): Promise<JobDeletionCleanupPage>;
  markJobDeleted(jobId: string, deletedBy: string): Promise<JobRecord | null>;
  purgeExpiredJobs(options: MaintenancePageOptions): Promise<PurgedJobsPage>;

  // --- UploadSession CRUD ---
  createUploadSession(session: UploadSessionRecord): Promise<UploadSessionRecord>;
  getUploadSession(jobId: string): Promise<UploadSessionRecord | null>;
  claimUploadSessionForCompletion(jobId: string, claimId: string): Promise<UploadSessionCompletionClaimResult>;
  releaseUploadSessionCompletion(jobId: string, claimId: string): Promise<void>;
  completeUploadSession(jobId: string, updates?: Partial<UploadSessionRecord>, claimId?: string): Promise<UploadSessionRecord | null>;
  expireUploadSessionsForCleanup(options: MaintenancePageOptions): Promise<ExpiredUploadSessionsPage>;
  claimExpiredUploadObject(candidate: UploadSessionRecord): Promise<UploadSessionRecord | null>;
  finalizeExpiredUploadObject(jobId: string, claimId: string): Promise<boolean>;
  expireUploadSessions(before?: Date): Promise<number>;
}

// ---------------------------------------------------------------------------
// MemoryJobStore
// ---------------------------------------------------------------------------

export class MemoryJobStore implements JobStore {
  private readonly jobs = new Map<string, JobRecord>();
  private readonly uploadSessions = new Map<string, UploadSessionRecord>();
  private readonly deletionCleanup = new Map<string, JobDeletionCleanupRecord>();

  async createJob(input: CreateJobInput) {
    if (this.jobs.has(input.jobId)) {
      throw new Error("Job already exists");
    }
    const now = new Date().toISOString();
    const job: JobRecord = {
      ...input,
      createdAt: now,
      updatedAt: now,
    };

    this.jobs.set(job.jobId, job);
    return job;
  }

  async getJob(jobId: string) {
    const job = this.jobs.get(jobId);
    if (!job) return undefined;

    // Deleted jobs are not auto-expired; they are tombstones.
    if (isDeleted(job)) return isTombstonePurged(job) ? undefined : job;

    if (job.status === "expired" || !isExpired(job)) return job;

    const expiredJob = toExpiredJob(job);
    this.jobs.set(jobId, expiredJob);
    return expiredJob;
  }

  async updateJob(jobId: string, patch: UpdateJobPatch) {
    const current = this.jobs.get(jobId);
    if (!current) return undefined;

    // Worker no-op on deleted job: do not resurrect a deleted job.
    if (isDeleted(current)) {
      return current;
    }

    const updated = applyJobPatch(current, patch);

    this.jobs.set(jobId, updated);
    return updated;
  }

  async claimQueuedJobForProcessing(jobId: string, beforeCommit?: ClaimMutationHook) {
    const observed = this.jobs.get(jobId);
    if (!observed) return { status: "not_found" } as const;

    const unclaimable = classifyUnclaimableJob(observed);
    if (unclaimable) return unclaimable;

    await beforeCommit?.();

    const current = this.jobs.get(jobId);
    if (!current) return { status: "not_found" } as const;

    if (current.status !== "queued" || isDeleted(current) || isExpired(current)) {
      return { status: "lock_lost", current } as const;
    }

    const claimed = toProcessingJob(current);
    this.jobs.set(jobId, claimed);
    return { status: "claimed", job: claimed } as const;
  }

  async recoverStaleProcessingJobs(options: MaintenancePageOptions, beforeCommit?: MaintenanceMutationHook) {
    const cutoffIso = options.cutoff.toISOString();
    const cursor = parseMaintenanceCursor(options.cursor);
    const candidates = Array.from(this.jobs.values())
      .filter((job) => (job.status === "processing" || job.status === "queued") && job.updatedAt < cutoffIso)
      .sort((a, b) => a.updatedAt.localeCompare(b.updatedAt) || a.jobId.localeCompare(b.jobId))
      .filter((job) => isAfterMaintenanceCursor(job.updatedAt, job.jobId, cursor))
      .slice(0, Math.max(0, options.limit));
    const jobs: JobRecord[] = [];
    for (const candidate of candidates) {
      await beforeCommit?.(candidate.jobId);
      const current = this.jobs.get(candidate.jobId);
      if (!current || (current.status !== "processing" && current.status !== "queued") || current.updatedAt !== candidate.updatedAt || current.updatedAt >= cutoffIso) continue;
      const recoveredAt = new Date(Math.max(Date.now(), options.cutoff.getTime() + 1)).toISOString();
      const recovered = { ...current, status: "queued" as const, progress: 60, message: "대기 중인 작업이 재시도 대기열에 재등록되었습니다.", updatedAt: recoveredAt };
      this.jobs.set(candidate.jobId, recovered);
      jobs.push(recovered);
    }
    const last = candidates.at(-1);
    return { jobs, nextCursor: candidates.length === options.limit && last ? maintenanceCursor(last.updatedAt, last.jobId) : undefined };
  }

  async getJobForUser(jobId: string, userId: string) {
    const job = this.jobs.get(jobId);
    if (!job) return null;
    if (isDeleted(job)) return null;
    if (job.ownerType !== "user" || job.userId !== userId) return null;
    if (isMetadataExpired(job)) return null;

    // Auto-expire download if needed.
    if (job.status !== "expired" && isExpired(job)) {
      const expiredJob = toExpiredJob(job);
      this.jobs.set(jobId, expiredJob);
      return expiredJob;
    }

    return job;
  }

  async getJobForAnonymous(jobId: string, accessTokenHash: string) {
    const job = this.jobs.get(jobId);
    if (!job) return null;
    if (isDeleted(job)) return null;
    if (job.ownerType !== "anonymous" || job.accessTokenHash !== accessTokenHash) return null;

    // Auto-expire download if needed.
    if (job.status !== "expired" && isExpired(job)) {
      const expiredJob = toExpiredJob(job);
      this.jobs.set(jobId, expiredJob);
      return expiredJob;
    }

    return job;
  }

  async listJobsByUser(userId: string, options: ListJobsByUserOptions = {}) {
    const { includeDeleted = false, limit, offset = 0 } = options;

    const jobs = Array.from(this.jobs.values()).filter((job) => {
      if (job.ownerType !== "user" || job.userId !== userId) return false;
      if (isDeleted(job)) {
        if (!includeDeleted) return false;
        // Even with includeDeleted, exclude purged tombstones.
        if (isTombstonePurged(job)) return false;
        return true;
      }
      if (isMetadataExpired(job)) return false;
      return true;
    });

    // Sort by createdAt descending (newest first).
    jobs.sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));

    const start = offset;
    const end = limit !== undefined ? start + limit : undefined;
    return jobs.slice(start, end);
  }

  async claimJobDeletion(jobId: string, deletedBy: string, claimId: string) {
    const current = this.jobs.get(jobId);
    const result = classifyJobDeletion(current, deletedBy);
    if (result?.status === "in_progress") {
      if (result.tombstone.ownerType !== "user" || result.tombstone.userId !== deletedBy) {
        return { status: "forbidden" } as const;
      }
      const cleanup = this.deletionCleanup.get(jobId);
      if (!cleanup) return result;
      if (Date.parse(cleanup.leaseExpiresAt) > Date.now()) return result;
      const deadline = leaseExpiresAt();
      this.deletionCleanup.set(jobId, { ...cleanup, claimId, leaseExpiresAt: deadline });
      return { status: "claimed", job: cleanup.job, tombstone: result.tombstone, claimId } as const;
    }
    if (result) return result;
    if (!current) return { status: "not_found" } as const;
    const deadline = leaseExpiresAt();
    const tombstone = toDeletedJob(current, deletedBy);
    this.jobs.set(jobId, tombstone);
    this.deletionCleanup.set(jobId, { jobId, claimId, leaseExpiresAt: deadline, job: current });
    return { status: "claimed", job: current, tombstone, claimId } as const;
  }

  async markJobDeleted(jobId: string, deletedBy: string) {
    const result = await this.claimJobDeletion(jobId, deletedBy, crypto.randomUUID());
    if (result.status === "claimed") return this.finalizeJobDeletion(jobId, result.claimId);
    if (result.status === "already_deleted") return result.tombstone;
    return null;
  }

  async finalizeJobDeletion(jobId: string, claimId: string) {
    const current = this.jobs.get(jobId);
    const cleanup = this.deletionCleanup.get(jobId);
    if (!cleanup || cleanup.claimId !== claimId || (current && !isDeleted(current))) return null;
    const finalized = finalizedDeletionResult(current, cleanup);
    if (current) this.jobs.set(jobId, finalized);
    this.deletionCleanup.delete(jobId);
    return finalized;
  }

  async claimExpiredJobDeletions(options: MaintenancePageOptions) {
    const candidates = Array.from(this.deletionCleanup.values())
      .filter((cleanup) => Date.parse(cleanup.leaseExpiresAt) <= options.cutoff.getTime())
      .sort((a, b) => a.leaseExpiresAt.localeCompare(b.leaseExpiresAt) || a.jobId.localeCompare(b.jobId));
    const selected = candidates.slice(0, Math.max(0, options.limit));
    const claims = selected.map((cleanup) => {
      const claimId = crypto.randomUUID();
      this.deletionCleanup.set(cleanup.jobId, { ...cleanup, claimId, leaseExpiresAt: leaseExpiresAt() });
      return { job: cleanup.job, claimId };
    });
    return { claims, hasMore: candidates.length > selected.length };
  }

  async purgeExpiredJobs(options: MaintenancePageOptions) {
    const cutoff = options.cutoff.getTime();
    const candidates = Array.from(this.jobs.values())
      .filter((job) => {
        const deadline = isDeleted(job) ? job.tombstoneUntil : job.metadataExpiresAt;
        return deadline !== undefined && Date.parse(deadline) <= cutoff;
      })
      .sort((a, b) => a.jobId.localeCompare(b.jobId));
    const selected = candidates.slice(0, Math.max(0, options.limit));
    for (const job of selected) this.jobs.delete(job.jobId);
    return { purged: selected.length, hasMore: candidates.length > selected.length };
  }

  // --- UploadSession CRUD ---

  async createUploadSession(session: UploadSessionRecord) {
    this.uploadSessions.set(session.jobId, session);
    return session;
  }

  async getUploadSession(jobId: string) {
    const session = this.uploadSessions.get(jobId);
    return session ?? null;
  }

  async claimUploadSessionForCompletion(jobId: string, claimId: string) {
    const current = this.uploadSessions.get(jobId);
    if (!current) return { status: "not_found" } as const;
    if (current.completedAt || current.status === "completed") {
      return { status: "completed", session: current } as const;
    }
    const existingJob = this.jobs.get(jobId);
    if (existingJob && !hasSameUploadJobIdentity(existingJob, current)) {
      return { status: "conflict", session: current } as const;
    }
    if (current.cleanupClaimedAt) return { status: "expired", session: current } as const;
    if (current.completionClaimId && Date.parse(current.completionLeaseExpiresAt ?? "") > Date.now()) {
      return { status: "already_claimed", session: current } as const;
    }
    if (!existingJob && (current.status === "expired" || Date.parse(current.expiresAt) <= Date.now())) {
      return { status: "expired", session: current } as const;
    }
    const claimed = {
      ...current,
      status: "active" as const,
      expiredAt: undefined,
      completionClaimId: claimId,
      completionLeaseExpiresAt: leaseExpiresAt(),
    };
    this.uploadSessions.set(jobId, claimed);
    return { status: "claimed", session: claimed, existingJob } as const;
  }

  async releaseUploadSessionCompletion(jobId: string, claimId: string) {
    const current = this.uploadSessions.get(jobId);
    if (!current || current.completionClaimId !== claimId || current.completedAt) return;
    const {
      completionClaimId: _completionClaimId,
      completionLeaseExpiresAt: _completionLeaseExpiresAt,
      ...released
    } = current;
    this.uploadSessions.set(jobId, released);
  }

  async completeUploadSession(jobId: string, updates?: Partial<UploadSessionRecord>, claimId?: string) {
    const current = this.uploadSessions.get(jobId);
    if (!current) return null;
    if (!claimId || current.completionClaimId !== claimId) return null;

    const completed: UploadSessionRecord = {
      ...current,
      ...updates,
      completionClaimId: undefined,
      completionLeaseExpiresAt: undefined,
      status: "completed",
      completedAt: new Date().toISOString(),
    };

    this.uploadSessions.delete(jobId);
    return completed;
  }

  async expireUploadSessionsForCleanup(options: MaintenancePageOptions) {
    const cursor = parseMaintenanceCursor(options.cursor);
    const limit = Math.max(0, options.limit);
    const scanned = Array.from(this.uploadSessions.values())
      .filter((item) => item.expiresAt <= options.cutoff.toISOString())
      .sort((a, b) => a.expiresAt.localeCompare(b.expiresAt) || a.jobId.localeCompare(b.jobId))
      .filter((item) => isAfterMaintenanceCursor(item.expiresAt, item.jobId, cursor))
      .slice(0, limit + 1);
    const candidates = scanned.slice(0, limit);
    const sessions: UploadSessionRecord[] = [];
    const cleanupDiagnostics = emptyCleanupDiagnostics();
    for (const candidate of candidates) {
      const existingJob = this.jobs.get(candidate.jobId);
      if (existingJob && hasSameUploadJobIdentity(existingJob, candidate)) {
        cleanupDiagnostics.completedOrStatus += 1;
        continue;
      }
      const outcome = classifyUploadCleanupCandidate(candidate, candidate, options.cutoff);
      if (typeof outcome === "string") {
        cleanupDiagnostics[outcome] += 1;
        continue;
      }
      const expired = candidate.status === "expired"
        ? candidate
        : { ...candidate, status: "expired" as const, expiredAt: options.cutoff.toISOString() };
      this.uploadSessions.set(expired.jobId, expired);
      cleanupDiagnostics.accepted += 1;
      sessions.push(expired);
    }
    const last = candidates.at(-1);
    return {
      sessions,
      nextCursor: scanned.length > limit && last ? maintenanceCursor(last.expiresAt, last.jobId) : undefined,
      cleanupDiagnostics,
    };
  }

  async claimExpiredUploadObject(candidate: UploadSessionRecord) {
    const current = this.uploadSessions.get(candidate.jobId);
    if (!current || !isUploadCleanupEligible(current)) return null;
    const existingJob = this.jobs.get(candidate.jobId);
    if (existingJob && hasSameUploadJobIdentity(existingJob, current)) return null;
    if (!hasSameUploadCleanupIdentity(current, candidate)) return null;
    const claimed = {
      ...current,
      cleanupClaimedAt: new Date().toISOString(),
      cleanupClaimId: crypto.randomUUID(),
      cleanupLeaseExpiresAt: leaseExpiresAt(),
    };
    this.uploadSessions.set(current.jobId, claimed);
    return claimed;
  }

  async finalizeExpiredUploadObject(jobId: string, claimId: string) {
    const current = this.uploadSessions.get(jobId);
    if (!current || current.cleanupClaimId !== claimId) return false;
    this.uploadSessions.delete(jobId);
    return true;
  }

  async expireUploadSessions(before = new Date()) {
    const result = await this.expireUploadSessionsForCleanup({ cutoff: before, limit: 100 });
    return result.sessions.length;
  }
}

// ---------------------------------------------------------------------------
// FirestoreJobStore
// ---------------------------------------------------------------------------

export class FirestoreJobStore implements JobStore {
  private readonly firestore: Firestore;

  private readonly collection;
  private readonly sessionsCollection;
  private readonly deletionCleanupCollection;

  constructor(firestore?: Firestore) {
    this.firestore = firestore ?? new Firestore({
      projectId: config.firestoreProjectId || undefined,
      databaseId: config.firestoreDatabaseId,
      ignoreUndefinedProperties: true,
    });
    this.collection = this.firestore.collection(config.firestoreJobsCollection);
    this.sessionsCollection = this.firestore.collection(
      process.env.FIRESTORE_UPLOAD_SESSIONS_COLLECTION ?? "uploadSessions",
    );
    this.deletionCleanupCollection = this.firestore.collection(
      process.env.FIRESTORE_JOB_DELETION_CLEANUP_COLLECTION ?? "jobDeletionCleanup",
    );
  }

  async createJob(input: CreateJobInput) {
    const now = new Date().toISOString();
    const job: JobRecord = {
      ...input,
      createdAt: now,
      updatedAt: now,
    };

    const ref = this.collection.doc(job.jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (snapshot.exists) throw new Error("Job already exists");
      transaction.create(ref, job);
      return job;
    });
  }

  async getJob(jobId: string) {
    const ref = this.collection.doc(jobId);
    const snapshot = await ref.get();
    if (!snapshot.exists) return undefined;

    const job = snapshot.data() as JobRecord;

    // Deleted jobs are not auto-expired; they are tombstones.
    if (isDeleted(job)) return isTombstonePurged(job) ? undefined : job;

    if (job.status === "expired" || !isExpired(job)) return job;

    const expiredJob = toExpiredJob(job);
    await ref.set(expiredJob);
    return expiredJob;
  }

  async updateJob(jobId: string, patch: UpdateJobPatch) {
    const ref = this.collection.doc(jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (!snapshot.exists) return undefined;

      const current = snapshot.data() as JobRecord;
      if (isDeleted(current)) return current;

      const updated = applyJobPatch(current, patch);
      transaction.set(ref, updated);
      return updated;
    });
  }

  async claimQueuedJobForProcessing(jobId: string, beforeCommit?: ClaimMutationHook) {
    const ref = this.collection.doc(jobId);

    return this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (!snapshot.exists) return { status: "not_found" } as const;

      const current = snapshot.data() as JobRecord;
      const unclaimable = classifyUnclaimableJob(current);
      if (unclaimable) return unclaimable;

      await beforeCommit?.();

      const claimed = toProcessingJob(current);
      transaction.set(ref, claimed);
      return { status: "claimed", job: claimed } as const;
    });
  }

  async recoverStaleProcessingJobs(options: MaintenancePageOptions, beforeCommit?: MaintenanceMutationHook) {
    const buildQuery = (status: "processing" | "queued") => {
      let query: FirebaseFirestore.Query = this.collection
        .where("status", "==", status)
        .where("updatedAt", "<", options.cutoff.toISOString())
        .orderBy("updatedAt", "asc")
        .orderBy(FieldPath.documentId(), "asc");
      const cursor = parseMaintenanceCursor(options.cursor);
      if (cursor) query = query.startAfter(...cursor);
      return query.limit(Math.max(0, options.limit));
    };
    const cursor = parseMaintenanceCursor(options.cursor);
    void cursor;
    const snapshots = await Promise.all([buildQuery("processing").get(), buildQuery("queued").get()]);
    const docs = snapshots
      .flatMap((snapshot) => snapshot.docs)
      .sort((a, b) => {
        const aJob = a.data() as JobRecord;
        const bJob = b.data() as JobRecord;
        return aJob.updatedAt.localeCompare(bJob.updatedAt) || a.id.localeCompare(b.id);
      })
      .slice(0, Math.max(0, options.limit));
    const jobs: JobRecord[] = [];
    for (const doc of docs) {
      await beforeCommit?.(doc.id);
      const recovered = await this.firestore.runTransaction(async (transaction) => {
        const currentSnapshot = await transaction.get(doc.ref);
        if (!currentSnapshot.exists) return null;
        const current = currentSnapshot.data() as JobRecord;
        const scanned = doc.data() as JobRecord;
        if ((current.status !== "processing" && current.status !== "queued") || current.updatedAt !== scanned.updatedAt || current.updatedAt >= options.cutoff.toISOString()) return null;
        const recoveredAt = new Date(Math.max(Date.now(), options.cutoff.getTime() + 1)).toISOString();
        const value = { ...current, status: "queued" as const, progress: 60, message: "대기 중인 작업이 재시도 대기열에 재등록되었습니다.", updatedAt: recoveredAt };
        transaction.set(doc.ref, value);
        return value;
      });
      if (recovered) jobs.push(recovered);
    }
    const last = docs.at(-1);
    const lastJob = last?.data() as JobRecord | undefined;
    return { jobs, nextCursor: docs.length === options.limit && last && lastJob ? maintenanceCursor(lastJob.updatedAt, last.id) : undefined };
  }

  async getJobForUser(jobId: string, userId: string) {
    const ref = this.collection.doc(jobId);
    const snapshot = await ref.get();
    if (!snapshot.exists) return null;

    const job = snapshot.data() as JobRecord;
    if (isDeleted(job)) return null;
    if (job.ownerType !== "user" || job.userId !== userId) return null;
    if (isMetadataExpired(job)) return null;

    if (job.status !== "expired" && isExpired(job)) {
      const expiredJob = toExpiredJob(job);
      await ref.set(expiredJob);
      return expiredJob;
    }

    return job;
  }

  async getJobForAnonymous(jobId: string, accessTokenHash: string) {
    const ref = this.collection.doc(jobId);
    const snapshot = await ref.get();
    if (!snapshot.exists) return null;

    const job = snapshot.data() as JobRecord;
    if (isDeleted(job)) return null;
    if (job.ownerType !== "anonymous" || job.accessTokenHash !== accessTokenHash) return null;

    if (job.status !== "expired" && isExpired(job)) {
      const expiredJob = toExpiredJob(job);
      await ref.set(expiredJob);
      return expiredJob;
    }

    return job;
  }

  async listJobsByUser(userId: string, options: ListJobsByUserOptions = {}) {
    const { includeDeleted = false, limit, offset = 0 } = options;

    // Query user's non-deleted jobs by default.
    let query: FirebaseFirestore.Query = this.collection
      .where("ownerType", "==", "user")
      .where("userId", "==", userId);

    query = query.orderBy("createdAt", "desc");

    const snapshot = await query.get();

    let jobs = snapshot.docs.map((doc) => doc.data() as JobRecord);

    jobs = includeDeleted
      ? jobs.filter((job) => isDeleted(job) ? !isTombstonePurged(job) : !isMetadataExpired(job))
      : jobs.filter((job) => !isDeleted(job) && !isMetadataExpired(job));

    // Apply offset in memory (Firestore offset() is less efficient).
    if (offset > 0) {
      jobs = jobs.slice(offset);
    }

    if (limit !== undefined) {
      jobs = jobs.slice(0, limit);
    }

    return jobs;
  }

  async claimJobDeletion(jobId: string, deletedBy: string, claimId: string) {
    const ref = this.collection.doc(jobId);
    const cleanupRef = this.deletionCleanupCollection.doc(jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const [snapshot, cleanupSnapshot] = await Promise.all([
        transaction.get(ref),
        transaction.get(cleanupRef),
      ]);
      const current = snapshot.exists ? snapshot.data() as JobRecord : undefined;
      const result = classifyJobDeletion(current, deletedBy);
      if (result?.status === "in_progress") {
        if (result.tombstone.ownerType !== "user" || result.tombstone.userId !== deletedBy) {
          return { status: "forbidden" } as const;
        }
        if (!cleanupSnapshot.exists) return result;
        const cleanup = cleanupSnapshot.data() as JobDeletionCleanupRecord;
        if (Date.parse(cleanup.leaseExpiresAt) > Date.now()) return result;
        const deadline = leaseExpiresAt();
        transaction.set(cleanupRef, { ...cleanup, claimId, leaseExpiresAt: deadline });
        return { status: "claimed", job: cleanup.job, tombstone: result.tombstone, claimId } as const;
      }
      if (result) return result;
      if (!current) return { status: "not_found" } as const;
      const deadline = leaseExpiresAt();
      const tombstone = toDeletedJob(current, deletedBy);
      transaction.set(ref, tombstone);
      transaction.set(cleanupRef, { jobId, claimId, leaseExpiresAt: deadline, job: current });
      return { status: "claimed", job: current, tombstone, claimId } as const;
    });
  }

  async markJobDeleted(jobId: string, deletedBy: string) {
    const result = await this.claimJobDeletion(jobId, deletedBy, crypto.randomUUID());
    if (result.status === "claimed") return this.finalizeJobDeletion(jobId, result.claimId);
    if (result.status === "already_deleted") return result.tombstone;
    return null;
  }

  async finalizeJobDeletion(jobId: string, claimId: string) {
    const ref = this.collection.doc(jobId);
    const cleanupRef = this.deletionCleanupCollection.doc(jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const [snapshot, cleanupSnapshot] = await Promise.all([
        transaction.get(ref),
        transaction.get(cleanupRef),
      ]);
      if (!cleanupSnapshot.exists) return null;
      const current = snapshot.exists ? snapshot.data() as JobRecord : undefined;
      const cleanup = cleanupSnapshot.data() as JobDeletionCleanupRecord;
      if ((current && !isDeleted(current)) || cleanup.claimId !== claimId) return null;
      const finalized = finalizedDeletionResult(current, cleanup);
      if (current) transaction.set(ref, finalized);
      transaction.delete(cleanupRef);
      return finalized;
    });
  }

  async claimExpiredJobDeletions(options: MaintenancePageOptions) {
    const snapshot = await this.deletionCleanupCollection
      .where("leaseExpiresAt", "<=", options.cutoff.toISOString())
      .orderBy("leaseExpiresAt", "asc")
      .limit(Math.max(0, options.limit) + 1)
      .get();
    const selected = snapshot.docs.slice(0, Math.max(0, options.limit));
    const claims: Array<{ job: JobRecord; claimId: string }> = [];
    for (const candidate of selected) {
      const claimed = await this.firestore.runTransaction(async (transaction) => {
        const currentSnapshot = await transaction.get(candidate.ref);
        if (!currentSnapshot.exists) return null;
        const current = currentSnapshot.data() as JobDeletionCleanupRecord;
        if (Date.parse(current.leaseExpiresAt) > options.cutoff.getTime()) return null;
        const claimId = crypto.randomUUID();
        transaction.set(candidate.ref, { ...current, claimId, leaseExpiresAt: leaseExpiresAt() });
        return { job: current.job, claimId };
      });
      if (claimed) claims.push(claimed);
    }
    return { claims, hasMore: snapshot.size > selected.length };
  }

  async purgeExpiredJobs(options: MaintenancePageOptions) {
    const cutoff = options.cutoff.toISOString();
    const limit = Math.max(0, options.limit);
    const [metadataSnapshot, tombstoneSnapshot] = await Promise.all([
      this.collection.where("metadataExpiresAt", "<=", cutoff).orderBy("metadataExpiresAt", "asc").limit(limit + 1).get(),
      this.collection.where("tombstoneUntil", "<=", cutoff).orderBy("tombstoneUntil", "asc").limit(limit + 1).get(),
    ]);
    const candidates = [...metadataSnapshot.docs, ...tombstoneSnapshot.docs]
      .filter((doc, index, all) => all.findIndex((other) => other.id === doc.id) === index)
      .sort((a, b) => {
        const aJob = a.data() as JobRecord;
        const bJob = b.data() as JobRecord;
        const aDeadline = isDeleted(aJob) ? aJob.tombstoneUntil : aJob.metadataExpiresAt;
        const bDeadline = isDeleted(bJob) ? bJob.tombstoneUntil : bJob.metadataExpiresAt;
        return (aDeadline ?? "").localeCompare(bDeadline ?? "") || a.id.localeCompare(b.id);
      });
    const selected = candidates.slice(0, limit);
    let purged = 0;
    for (const candidate of selected) {
      const deleted = await this.firestore.runTransaction(async (transaction) => {
        const snapshot = await transaction.get(candidate.ref);
        if (!snapshot.exists) return false;
        const current = snapshot.data() as JobRecord;
        const deadline = isDeleted(current) ? current.tombstoneUntil : current.metadataExpiresAt;
        if (!deadline || Date.parse(deadline) > options.cutoff.getTime()) return false;
        transaction.delete(candidate.ref);
        return true;
      });
      if (deleted) purged += 1;
    }
    return {
      purged,
      hasMore: candidates.length > selected.length || metadataSnapshot.size > limit || tombstoneSnapshot.size > limit,
    };
  }

  // --- UploadSession CRUD ---

  async createUploadSession(session: UploadSessionRecord) {
    await this.sessionsCollection.doc(session.jobId).set(session);
    return session;
  }

  async getUploadSession(jobId: string) {
    const snapshot = await this.sessionsCollection.doc(jobId).get();
    if (!snapshot.exists) return null;
    return snapshot.data() as UploadSessionRecord;
  }

  async claimUploadSessionForCompletion(jobId: string, claimId: string) {
    const ref = this.sessionsCollection.doc(jobId);
    const jobRef = this.collection.doc(jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const [snapshot, jobSnapshot] = await Promise.all([
        transaction.get(ref),
        transaction.get(jobRef),
      ]);
      if (!snapshot.exists) return { status: "not_found" } as const;
      const current = snapshot.data() as UploadSessionRecord;
      if (current.completedAt || current.status === "completed") {
        return { status: "completed", session: current } as const;
      }
      const existingJob = jobSnapshot.exists ? jobSnapshot.data() as JobRecord : undefined;
      if (existingJob && !hasSameUploadJobIdentity(existingJob, current)) {
        return { status: "conflict", session: current } as const;
      }
      if (current.cleanupClaimedAt) return { status: "expired", session: current } as const;
      if (current.completionClaimId && Date.parse(current.completionLeaseExpiresAt ?? "") > Date.now()) {
        return { status: "already_claimed", session: current } as const;
      }
      if (!existingJob && (current.status === "expired" || Date.parse(current.expiresAt) <= Date.now())) {
        return { status: "expired", session: current } as const;
      }
      const claimed = {
        ...current,
        status: "active" as const,
        expiredAt: undefined,
        completionClaimId: claimId,
        completionLeaseExpiresAt: leaseExpiresAt(),
      };
      transaction.set(ref, claimed);
      return { status: "claimed", session: claimed, existingJob } as const;
    });
  }

  async releaseUploadSessionCompletion(jobId: string, claimId: string) {
    const ref = this.sessionsCollection.doc(jobId);
    await this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (!snapshot.exists) return;
      const current = snapshot.data() as UploadSessionRecord;
      if (current.completionClaimId !== claimId || current.completedAt) return;
      const {
        completionClaimId: _completionClaimId,
        completionLeaseExpiresAt: _completionLeaseExpiresAt,
        ...released
      } = current;
      transaction.set(ref, released);
    });
  }

  async completeUploadSession(jobId: string, updates?: Partial<UploadSessionRecord>, claimId?: string) {
    const ref = this.sessionsCollection.doc(jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (!snapshot.exists) return null;
      const current = snapshot.data() as UploadSessionRecord;
      if (!claimId || current.completionClaimId !== claimId) return null;
      const completed: UploadSessionRecord = {
        ...current,
        ...updates,
        completionClaimId: undefined,
        completionLeaseExpiresAt: undefined,
        status: "completed",
        completedAt: new Date().toISOString(),
      };
      transaction.delete(ref);
      return completed;
    });
  }

  async expireUploadSessionsForCleanup(options: MaintenancePageOptions) {
    let query: FirebaseFirestore.Query = this.sessionsCollection
      .where("expiresAt", "<=", options.cutoff.toISOString())
      .orderBy("expiresAt", "asc")
      .orderBy(FieldPath.documentId(), "asc");
    const cursor = parseMaintenanceCursor(options.cursor);
    if (cursor) query = query.startAfter(...cursor);
    const limit = Math.max(0, options.limit);
    const snapshot = await query.limit(limit + 1).get();
    const candidates = snapshot.docs.slice(0, limit);
    const sessions: UploadSessionRecord[] = [];
    const cleanupDiagnostics = emptyCleanupDiagnostics();
    for (const doc of candidates) {
      const outcome = await this.firestore.runTransaction(async (transaction) => {
        const currentSnapshot = await transaction.get(doc.ref);
        if (!currentSnapshot.exists) return "identityMismatch" as const;
        const current = currentSnapshot.data() as UploadSessionRecord;
        const scanned = doc.data() as UploadSessionRecord;
        const jobSnapshot = await transaction.get(this.collection.doc(current.jobId));
        if (jobSnapshot.exists && hasSameUploadJobIdentity(jobSnapshot.data() as JobRecord, current)) {
          return "completedOrStatus" as const;
        }
        const decision = classifyUploadCleanupCandidate(current, scanned, options.cutoff);
        if (typeof decision === "string" || current.status === "expired") return decision;
        const value = { ...current, status: "expired" as const, expiredAt: options.cutoff.toISOString() };
        transaction.set(doc.ref, value);
        return { accepted: value };
      });
      if (typeof outcome === "string") {
        cleanupDiagnostics[outcome] += 1;
      } else {
        cleanupDiagnostics.accepted += 1;
        sessions.push(outcome.accepted);
      }
    }
    const last = candidates.at(-1);
    const lastSession = last?.data() as UploadSessionRecord | undefined;
    return {
      sessions,
      nextCursor: snapshot.docs.length > limit && last && lastSession ? maintenanceCursor(lastSession.expiresAt, last.id) : undefined,
      cleanupDiagnostics,
    };
  }

  async claimExpiredUploadObject(candidate: UploadSessionRecord) {
    const ref = this.sessionsCollection.doc(candidate.jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (!snapshot.exists) return null;
      const current = snapshot.data() as UploadSessionRecord;
      if (!isUploadCleanupEligible(current)) return null;
      if (!hasSameUploadCleanupIdentity(current, candidate)) return null;
      const jobSnapshot = await transaction.get(this.collection.doc(current.jobId));
      if (jobSnapshot.exists && hasSameUploadJobIdentity(jobSnapshot.data() as JobRecord, current)) return null;
      const claimed = {
        ...current,
        cleanupClaimedAt: new Date().toISOString(),
        cleanupClaimId: crypto.randomUUID(),
        cleanupLeaseExpiresAt: leaseExpiresAt(),
      };
      transaction.set(ref, claimed);
      return claimed;
    });
  }

  async finalizeExpiredUploadObject(jobId: string, claimId: string) {
    const ref = this.sessionsCollection.doc(jobId);
    return this.firestore.runTransaction(async (transaction) => {
      const snapshot = await transaction.get(ref);
      if (!snapshot.exists) return false;
      const current = snapshot.data() as UploadSessionRecord;
      if (current.cleanupClaimId !== claimId) return false;
      transaction.delete(ref);
      return true;
    });
  }

  async expireUploadSessions(before = new Date()) {
    const result = await this.expireUploadSessionsForCleanup({ cutoff: before, limit: 100 });
    return result.sessions.length;
  }
}

