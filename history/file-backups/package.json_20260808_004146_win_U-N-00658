{
  "name": "hwp2pdf",
  "private": true,
  "version": "1.0.0",
  "description": "HWP to PDF conversion service",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "postcss@<=8.5.11": "8.5.12",
      "protobufjs@>=7.5.0 <=7.6.4": "7.6.5",
      "sharp@<0.35.0": "0.35.0",
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
